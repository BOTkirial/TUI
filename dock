#!/usr/bin/env sh
# Lance le client Docker dans le conteneur (démarre la stack au besoin).
set -e
cd "$(dirname "$0")"
docker compose up -d
# docker exec et non « compose exec » : sa séquence de détachement par défaut
# (ctrl-p,ctrl-q) retient chaque ctrl+p jusqu'à la touche suivante (palette).
exec docker exec -it --detach-keys=ctrl-^,ctrl-^ "$(docker compose ps -q tui)" docker-tui
