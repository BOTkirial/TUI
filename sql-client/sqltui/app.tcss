/* Client SQL — complète common.tcss (styles partagés des TUI) */

/* --- écran d'accueil (connexions) : bloc centré --- */
ConnectionScreen {
    align: center top;
}

#conn-page {
    width: 90;
    max-width: 100%;
    /* toute la hauteur : la liste prend la place restante (et rétrécit sur un
       petit terminal au lieu de pousser boutons et statut hors de l'écran) */
    height: 1fr;
    margin: 1 0;
    padding: 1 2;
    border: round $accent;
}

/* terminal bas (VERTICAL_BREAKPOINTS de ConnectionScreen) : marges et aide
   retirées pour garder boutons et statut (progression, erreurs) à l'écran */
ConnectionScreen.-short #conn-page {
    margin: 0;
    padding: 0 2;
}

ConnectionScreen.-short #conn-page .hint {
    display: none;
}

#filter {
    margin-bottom: 1;
}

/* hauteur souple : au moins 2 connexions visibles */
#connections {
    height: 1fr;
    min-height: 4;
}

/* --- écran de requêtes --- */
#main {
    height: 1fr;
}

#sidebar {
    width: 38;
    padding: 1;
    border-right: solid $primary-darken-2;
}

#workspace {
    width: 1fr;
    padding: 1;
}

#tables {
    height: 1fr;
}

.editor-area {
    height: 8;
    margin-bottom: 1;
}

#results {
    height: 1fr;
}

/* statut + bouton plein écran sur une seule ligne */
#status-bar {
    height: auto;
    margin-top: 1;
}

#status-bar #status {
    width: 1fr;
    margin-top: 0;
}

/* plein écran (ctrl+f) : seuls les résultats, le statut et le pied de page */
QueryScreen.-results-full #sidebar,
QueryScreen.-results-full #query-title,
QueryScreen.-results-full #query {
    display: none;
}

QueryScreen.-results-full #workspace {
    padding: 0;
}

/* --- formulaire de connexion (fenêtre modale) --- */
ConnectionForm {
    /* formulaire haut (tunnel SSH) : défile sur un petit terminal */
    overflow-y: auto;
}

ConnectionForm #dialog {
    width: 110;
}

#form-columns {
    height: auto;
}

.form-column {
    width: 1fr;
    height: auto;
}

.form-column:first-child {
    margin-right: 2;
}

#dialog Input, #dialog Select, #dialog Checkbox {
    margin-bottom: 1;
}

/* les champs ont déjà leur marge basse */
ConnectionForm #dialog-buttons {
    margin-top: 0;
}

#form-status {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

/* --- édition d'une cellule (fenêtre modale) --- */
CellEditor #dialog {
    width: 80;
}

#cell-value {
    height: 8;
}
