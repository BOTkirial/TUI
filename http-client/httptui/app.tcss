/* Client HTTP — complète common.tcss (styles partagés des TUI) */

/* --- écran d'accueil (liste des requêtes) : bloc centré --- */
RequestListScreen {
    align: center top;
}

#list-page {
    width: 90;
    max-width: 100%;
    height: 1fr;
    margin: 1 0;
    padding: 1 2;
    border: round $accent;
}

#request-filter {
    margin-bottom: 1;
}

#requests {
    height: 1fr;
}

/* --- écran d'une requête --- */
#editor {
    width: 1fr;
    padding: 1;
}

#request-line {
    height: auto;
    margin: 1 0;
}

#method {
    width: 14;
}

#url {
    width: 1fr;
}

#actions {
    margin-bottom: 1;
}

#fuzzlist {
    width: 32;
}

#main-tabs, #request-parts {
    height: 1fr;
}

.editor-area {
    height: 1fr;
}

#fuzz-search {
    margin-bottom: 1;
}

#fuzz-results {
    height: 1fr;
}

/* --- fenêtres modales --- */
#dialog.wide {
    width: 90%;
    max-width: 140;
}

#curl-command {
    height: 14;
}
